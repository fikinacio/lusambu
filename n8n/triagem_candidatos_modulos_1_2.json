    {
      "id": "a1b2c3d4-2009-0000-0000-000000000009",
      "name": "🔄 Mapear Output Imagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 430],
      "parameters": {
        "jsCode": "const imageResult = $input.first().json;\nconst meta = $('🧹 Normalizar Payload').first().json;\n\nconst extractedText = imageResult.content\n  || imageResult.text\n  || imageResult.choices?.[0]?.message?.content\n  || JSON.stringify(imageResult);\n\nreturn [{\n  json: {\n    ...meta,\n    extracted_content: extractedText,\n    content_type: 'image'\n  }\n}];"
      }
    },
