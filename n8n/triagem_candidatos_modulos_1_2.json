        "jsCode": "const SUPABASE_URL = 'YOUR_SUPABASE_URL';\nconst SUPABASE_KEY = 'YOUR_SUPABASE_SERVICE_ROLE_KEY';\n\nconst result = await this.helpers.httpRequest({\n  method: 'GET',\n  url: SUPABASE_URL + '/rest/v1/triagem_vagas?status=eq.activa&limit=1',\n  headers: {\n    'apikey': SUPABASE_KEY,\n    'Authorization': 'Bearer ' + SUPABASE_KEY\n  },\n  json: true\n});\n\nif (!result || result.length === 0) {\n  return JSON.stringify({ message: 'Nenhuma vaga activa encontrada no sistema.' });\n}\nreturn JSON.stringify(result[0]);"
