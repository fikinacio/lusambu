    {
      "id": "a1b2c3d4-2011-0000-0000-000000000011",
      "name": "🔄 Converter Documento para Binário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1570, 600],
      "parameters": {
        "jsCode": "const base64 = $json.base64;\nconst meta = $('🧹 Normalizar Payload').first().json;\nconst msg = JSON.parse(meta.raw_message);\n\nconst mime = msg.documentMessage?.mimetype || 'application/octet-stream';\nconst fileName = msg.documentMessage?.fileName || 'documento';\n\nconst mimeToOp = {\n  'application/pdf': 'pdf',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document': 'docx',\n  'application/msword': 'docx',\n  'text/plain': 'text'\n};\nconst fileOp = mimeToOp[mime] || 'pdf';\n\nconst buffer = Buffer.from(base64, 'base64');\n\nreturn [{\n  json: { ...meta, doc_mime: mime, doc_filename: fileName, doc_operation: fileOp },\n  binary: {\n    data: {\n      data: buffer,\n      mimeType: mime,\n      fileName: fileName\n    }\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-2012-0000-0000-000000000012",
