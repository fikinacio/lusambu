        "description": "Submete o perfil completo do candidato quando todos os dados obrigatórios estiverem confirmados. Campos obrigatórios: nome (string), telefone (string), experiencia_anos (number), area_experiencia (string), disponibilidade (string: imediata|15_dias|30_dias|outro), expectativa_salarial_aoa (number), escolaridade (string: basico|medio|tecnico|licenciatura|mestrado|doutoramento), localizacao (string). Opcionais: tem_cv (boolean), notas_adicionais (string), score_estimado (number 0-100).",
        "jsCode": "const SUPABASE_URL = 'YOUR_SUPABASE_URL';\nconst SUPABASE_KEY = 'YOUR_SUPABASE_SERVICE_ROLE_KEY';\n\nconst args = JSON.parse(query);\n\nconst result = await this.helpers.httpRequest({\n  method: 'POST',\n  url: SUPABASE_URL + '/rest/v1/candidatos_qualificados',\n  headers: {\n    'apikey': SUPABASE_KEY,\n    'Authorization': 'Bearer ' + SUPABASE_KEY,\n    'Content-Type': 'application/json',\n    'Prefer': 'return=representation'\n  },\n  body: { ...args, status: 'pendente_revisao' },\n  json: true\n});\n\nreturn JSON.stringify({\n  success: true,\n  message: 'Candidato qualificado e guardado com sucesso.',\n  id: result[0]?.id || null\n});"
      },
