      "name": "⬇️ Obter Áudio Base64",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 260],
      "parameters": {
        "method": "POST",
        "url": "https://evolution.biscaplus.com/chat/getBase64FromMediaMessage/bmst",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ JSON.stringify({ message: { key: JSON.parse($json.raw_key), message: JSON.parse($json.raw_message) }, convertToMp4: false }) }}",
        "sendHeaders": true,
        "headerParameters": {
