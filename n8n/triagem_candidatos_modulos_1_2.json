    {
      "id": "a1b2c3d4-1005-0000-0000-000000000005",
      "name": "🧹 Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 310],
      "parameters": {
        "jsCode": "const data = $json.body.data;\nconst msgObj = data.message || {};\nconst messageType = Object.keys(msgObj)[0] || 'unknown';\n\nreturn [{\n  json: {\n    phone: data.key.remoteJid.replace('@s.whatsapp.net', ''),\n    candidate_name: data.pushName || '',\n    message_type: messageType,\n    timestamp: data.messageTimestamp,\n    raw_key: JSON.stringify(data.key),\n    raw_message: JSON.stringify(msgObj),\n    instance: $json.body.instance\n  }\n}];"
      }
    },
