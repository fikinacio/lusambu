    {
      "parameters": {
        "jsCode": "const base64 = $json.base64;\nconst meta = $('🧹 Normalizar Payload').first().json;\nconst msg = JSON.parse(meta.raw_message);\n\nconst mime = msg.documentMessage?.mimetype || 'application/octet-stream';\nconst fileName = msg.documentMessage?.fileName || 'documento';\nconst mimeToOp = {\n  'application/pdf': 'pdf',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document': 'docx',\n  'application/msword': 'docx',\n  'text/plain': 'text'\n};\nconst fileOp = mimeToOp[mime] || 'pdf';\nconst buffer = Buffer.from(base64, 'base64');\n\nreturn [{\n  json: { ...meta, doc_mime: mime, doc_filename: fileName, doc_operation: fileOp },\n  binary: { data: { data: buffer, mimeType: mime, fileName: fileName } }\n}];"
      },
