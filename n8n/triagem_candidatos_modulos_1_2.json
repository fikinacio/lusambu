        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "a1b2c3d4-1003-0000-0000-000000000003",
      "name": "🔍 É Mensagem de Candidato?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 310],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-event-check",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "messages.upsert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-fromme-check",
              "leftValue": "={{ $json.body.data.key.fromMe }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals",
                "rightType": "boolean"
              }
            },
            {
              "id": "cond-group-check",
              "leftValue": "={{ $json.body.data.key.remoteJid }}",
              "rightValue": "@g.us",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-1004-0000-0000-000000000004",
      "name": "⛔ Ignorar Mensagem",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 530],
      "parameters": {}
