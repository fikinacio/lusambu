    {
      "id": "a1b2c3d4-2004-0000-0000-000000000004",
      "name": "🔄 Converter Áudio para Binário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1570, 260],
      "parameters": {
        "jsCode": "const base64 = $json.base64;\nconst meta = $('🧹 Normalizar Payload').first().json;\nconst msg = JSON.parse(meta.raw_message);\n\nconst mime = msg.audioMessage?.mimetype || 'audio/ogg; codecs=opus';\nconst mimeClean = mime.split(';')[0].trim();\n\nconst extMap = {\n  'audio/ogg': 'ogg',\n  'audio/mpeg': 'mp3',\n  'audio/mp4': 'mp4',\n  'audio/wav': 'wav',\n  'audio/x-wav': 'wav',\n  'audio/m4a': 'm4a',\n  'audio/webm': 'webm'\n};\nconst ext = extMap[mimeClean] || 'ogg';\n\nconst buffer = Buffer.from(base64, 'base64');\n\nreturn [{\n  json: { ...meta, audio_mime: mimeClean, audio_ext: ext },\n  binary: {\n    data: {\n      data: buffer,\n      mimeType: mimeClean,\n      fileName: `audio.${ext}`\n    }\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-2005-0000-0000-000000000005",
