        "jsCode": "const SUPABASE_URL = 'YOUR_SUPABASE_URL';\nconst SUPABASE_KEY = 'YOUR_SUPABASE_SERVICE_ROLE_KEY';\n\nconst args = JSON.parse(query);\n\nawait this.helpers.httpRequest({\n  method: 'PATCH',\n  url: SUPABASE_URL + '/rest/v1/triagem_sessoes?phone=eq.' + encodeURIComponent(args.telefone),\n  headers: {\n    'apikey': SUPABASE_KEY,\n    'Authorization': 'Bearer ' + SUPABASE_KEY,\n    'Content-Type': 'application/json'\n  },\n  body: {\n    status: 'encerrada',\n    motivo_encerramento: args.motivo,\n    ultima_interacao: new Date().toISOString()\n  },\n  json: true\n});\n\nreturn JSON.stringify({\n  success: true,\n  message: 'Sessão encerrada. Motivo: ' + args.motivo\n});"
      },
