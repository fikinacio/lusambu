    {
      "id": "a1b2c3d4-2002-0000-0000-000000000002",
      "name": "📝 Extrair Texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 90],
      "parameters": {
        "jsCode": "const msg = JSON.parse($json.raw_message);\nconst text = msg.conversation || msg.extendedTextMessage?.text || '';\n\nreturn [{\n  json: {\n    ...$json,\n    extracted_content: text,\n    content_type: 'text',\n    binary_data: null\n  }\n}];"
      }
    },
