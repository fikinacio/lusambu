    {
      "parameters": {
        "jsCode": "const base64 = $json.base64;\nconst meta = $('🧹 Normalizar Payload').first().json;\nconst msg = JSON.parse(meta.raw_message);\n\nconst mime = msg.audioMessage?.mimetype || 'audio/ogg; codecs=opus';\nconst mimeClean = mime.split(';')[0].trim();\n\nconst extMap = {\n  'audio/ogg': 'ogg', 'audio/mpeg': 'mp3', 'audio/mp4': 'mp4',\n  'audio/wav': 'wav', 'audio/x-wav': 'wav', 'audio/m4a': 'm4a', 'audio/webm': 'webm'\n};\nconst ext = extMap[mimeClean] || 'ogg';\nconst buffer = Buffer.from(base64, 'base64');\n\nreturn [{\n  json: { ...meta, audio_mime: mimeClean, audio_ext: ext },\n  binary: { data: { data: buffer, mimeType: mimeClean, fileName: `audio.${ext}` } }\n}];"
      },
