    {
      "id": "a1b2c3d4-2013-0000-0000-000000000013",
      "name": "🔄 Mapear Output Documento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2070, 600],
      "parameters": {
        "jsCode": "const docData = $input.first().json;\nconst docMeta = $('🔄 Converter Documento para Binário').first().json;\nconst meta = $('🧹 Normalizar Payload').first().json;\n\nreturn [{\n  json: {\n    ...meta,\n    extracted_content: docData.text || docData.data || '',\n    content_type: 'document',\n    file_type: docMeta.doc_mime || 'application/pdf',\n    file_name: docMeta.doc_filename || 'documento'\n  }\n}];"
      }
